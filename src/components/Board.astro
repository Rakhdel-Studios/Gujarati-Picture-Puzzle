---
/**
 * The ONLY interactive island on the site. Plain <script> — no framework.
 *
 * Two rules baked in here on purpose:
 *  1. `tiles` and `decoys` arrive PRE-SPLIT into aksharas from the pipeline.
 *     They are rendered verbatim. Nothing in this file splits Gujarati text.
 *  2. No timers, no lives, no streaks, no penalties. A wrong answer just
 *     doesn't lock in; the player fixes it whenever they like.
 */
interface Props {
  slug: string;
  gujarati: string;
  tiles: string[];
  decoys: string[];
  nextHref: string | null;
}
const { slug, gujarati, tiles, decoys, nextHref } = Astro.props;

// Seeded shuffle at BUILD time: stable across reloads, no client-side shuffle
// code, and no visible reordering flash when the island hydrates.
function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const seed = [...slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7);
const rnd = mulberry32(seed);
const rack = [...tiles, ...decoys];
for (let i = rack.length - 1; i > 0; i--) {
  const j = Math.floor(rnd() * (i + 1));
  [rack[i], rack[j]] = [rack[j], rack[i]];
}
---

<section
  class:list={['board', { crowded: tiles.length >= 5 || rack.length >= 9 }]}
  data-answer={tiles.join('')}
  data-slots={tiles.length}
>
  <h2 class="sr-only">કોયડો / Puzzle</h2>

  <!-- Everything inside .play has to be visible at once on a phone: you cannot
       compare four pictures while the letters are off screen. -->
  <div class="play">
    <div class="pics">
    {
      [1, 2, 3, 4].map((n) => (
        <img
          src={`/images/${slug}/${n}.webp`}
          alt={`સંકેત ચિત્ર ${n} / Clue picture ${n}`}
          width="600"
          height="600"
          loading={n > 2 ? 'lazy' : 'eager'}
          decoding="async"
        />
        ))
      }
    </div>

  <!-- Answer slots. Always real buttons: tap a filled one to take the tile back. -->
  <div class="slots" role="group" aria-label="જવાબની જગ્યાઓ / Answer slots">
    {
      tiles.map((_, i) => (
        <button type="button" class="slot" data-slot={i} aria-label={`જગ્યા ${i + 1} — ખાલી / Slot ${i + 1}, empty`}>
          <span class="slot-glyph"></span>
        </button>
      ))
    }
  </div>

  <!-- One text band: the instruction while the slots are still filling, the
       verdict once they are full. A separate always-on prompt plus a separate
       status line cost a phone screen roughly a whole picture's worth of
       height, and the two never both matter at the same moment. -->
  <p class="status" role="status" aria-live="polite">
    <span class="status-gu">આ ચાર ચિત્રોનો શબ્દ બનાવો</span><span class="en"
      >Build the word these four pictures share</span
    >
  </p>

  <div class="rack" role="group" aria-label="અક્ષરો / Letters">
    {
      rack.map((glyph, i) => (
        <button type="button" class="tile" data-tile={i} data-glyph={glyph}>
          {glyph}
        </button>
      ))
    }
  </div>

  </div>

  <div class="controls">
    <button type="button" class="btn" data-clear>
      બધું કાઢો<span class="en">Clear all</span>
    </button>
    <!-- The hint: no gated hint system, the dictionary entry is just below. -->
    <a class="btn" href="#meaning">અટકી ગયા? અર્થ જુઓ<span class="en">Stuck? See the meaning</span></a>
  </div>

  <div class="win" hidden>
    <p class="win-mark" aria-hidden="true">✓</p>
    <p class="win-word" lang="gu">{gujarati}</p>
    <p class="win-text">
      સરસ! બરાબર જવાબ.
      <span class="en">Well done — that's the word.</span>
    </p>
    {
      nextHref ? (
        <a class="btn btn-primary" href={nextHref}>
          આગળનો કોયડો →<span class="en">Next puzzle</span>
        </a>
      ) : (
        <a class="btn btn-primary" href="/">
          બધા કોયડા →<span class="en">All puzzles</span>
        </a>
      )
    }
    <button type="button" class="btn" data-again>
      ફરી રમો<span class="en">Play again</span>
    </button>
  </div>
</section>

<script>
  const board = document.querySelector<HTMLElement>('.board');
  if (board) {
    const answer = board.dataset.answer ?? '';
    const slots = [...board.querySelectorAll<HTMLButtonElement>('.slot')];
    const tiles = [...board.querySelectorAll<HTMLButtonElement>('.tile')];
    const statusGu = board.querySelector<HTMLElement>('.status-gu')!;
    const statusEn = board.querySelector<HTMLElement>('.status .en')!;
    const IDLE: [string, string] = ['આ ચાર ચિત્રોનો શબ્દ બનાવો', 'Build the word these four pictures share'];
    const win = board.querySelector<HTMLElement>('.win')!;
    // slot index -> rack tile index currently sitting in it
    const placed: (number | null)[] = slots.map(() => null);

    const glyphOf = (t: HTMLButtonElement) => t.dataset.glyph ?? '';

    function paint() {
      slots.forEach((slot, i) => {
        const t = placed[i];
        const glyph = t === null ? '' : glyphOf(tiles[t]);
        slot.querySelector('.slot-glyph')!.textContent = glyph;
        slot.classList.toggle('filled', t !== null);
        slot.setAttribute(
          'aria-label',
          t === null
            ? `જગ્યા ${i + 1} — ખાલી / Slot ${i + 1}, empty`
            : `જગ્યા ${i + 1} — ${glyph}, પાછું લેવા દબાવો / Slot ${i + 1}, ${glyph}, press to take back`
        );
      });
      tiles.forEach((tile, i) => {
        const used = placed.includes(i);
        tile.classList.toggle('used', used);
        tile.disabled = used;
      });
    }

    function setState(kind: 'idle' | 'wrong' | 'correct', gu = '', en = '') {
      board.classList.remove('is-wrong', 'is-correct');
      if (kind !== 'idle') board.classList.add(`is-${kind}`);
      // Idle falls back to the instruction, so the band is never blank and
      // never changes height.
      statusGu.textContent = kind === 'idle' ? IDLE[0] : gu;
      statusEn.textContent = kind === 'idle' ? IDLE[1] : en;
    }

    function check() {
      if (placed.some((p) => p === null)) {
        setState('idle');
        return;
      }
      const guess = placed.map((p) => glyphOf(tiles[p!])).join('');
      if (guess === answer) {
        setState('correct', '✓ સાચું!', 'Correct!');
        win.hidden = false;
        win.querySelector<HTMLElement>('.btn')?.focus();
      } else {
        // No penalty. Nothing is lost, nothing locks. Just say so and wait.
        setState('wrong', '✗ હજી બરાબર નથી — અક્ષર દબાવીને પાછો લો.', 'Not yet — tap a letter to take it back.');
      }
    }

    function place(tileIndex: number) {
      const free = placed.indexOf(null);
      if (free === -1) return;
      placed[free] = tileIndex;
      paint();
      // Keep focus somewhere real: the slot that just received the tile.
      slots[free].focus();
      check();
    }

    function takeBack(slotIndex: number) {
      const t = placed[slotIndex];
      if (t === null) return;
      placed[slotIndex] = null;
      win.hidden = true;
      paint();
      tiles[t].focus();
      setState('idle');
    }

    tiles.forEach((tile, i) => tile.addEventListener('click', () => place(i)));
    slots.forEach((slot, i) => slot.addEventListener('click', () => takeBack(i)));

    function clearAll() {
      placed.fill(null);
      win.hidden = true;
      paint();
      setState('idle');
    }
    board.querySelector<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => {
      clearAll();
      tiles.find((t) => !t.disabled)?.focus();
    });
    board.querySelector<HTMLButtonElement>('[data-again]')?.addEventListener('click', () => {
      clearAll();
      tiles[0].focus();
    });

    paint();
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The 2x2 is a square box: two square cells plus one gap in each axis. Making
     the BOX square (rather than each image) means its height can be driven by
     the flex column below and its width follows — which is how the pictures
     give up space to the rack on a short phone instead of pushing it off screen. */
  .pics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    aspect-ratio: 1;
    gap: 10px;
    margin-bottom: 1.5rem;
    margin-inline: auto;
    max-width: 100%;
  }
  .pics img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    display: block;
    border: 3px solid var(--line-strong);
    border-radius: var(--radius);
    background: #eee;
  }

  /* --- answer slots ------------------------------------------------------- */
  .slots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 0.75rem;
  }
  .slot {
    width: 84px;
    height: 84px;
    padding: 0;
    display: grid;
    place-items: center;
    font-size: 2.5rem;
    line-height: 1;
    border-style: dashed;
    border-color: var(--line);
    background: #f4f1ea;
  }
  .slot.filled {
    border-style: solid;
    border-color: var(--line-strong);
    background: var(--card);
  }

  /* State is never signalled by colour alone: border STYLE and a text/glyph
     marker change too, so it reads in greyscale and for colour-blind players. */
  .is-wrong .slot.filled {
    border-style: dotted;
    border-width: 4px;
    border-color: var(--warn);
    background: var(--warn-soft);
  }
  .is-correct .slot.filled {
    border-color: var(--accent);
    background: var(--accent-soft);
    border-width: 4px;
  }

  .status {
    text-align: center;
    min-height: 3.2em;
    font-size: 0.82em;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .status .en {
    display: block;
  }
  .is-wrong .status {
    color: var(--warn);
  }
  .is-correct .status {
    color: var(--accent);
  }

  /* --- letter rack -------------------------------------------------------- */
  .rack {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px; /* generous: mis-taps are the main frustration for this audience */
    padding: 1rem 0.5rem;
    background: var(--card);
    border: 3px solid var(--line);
    border-radius: var(--radius);
  }
  .tile {
    width: 84px;
    height: 84px;
    padding: 0;
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 600;
    box-shadow: 0 4px 0 var(--line);
  }
  .tile:hover:not(:disabled) {
    background: var(--accent-soft);
  }
  .tile:active:not(:disabled) {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--line);
  }
  .tile.used {
    color: transparent;
    background: #eae6dd;
    border-style: dashed;
    border-color: var(--line);
    box-shadow: none;
    cursor: default;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin-top: 1.25rem;
  }

  /* --- win panel ---------------------------------------------------------- */
  .win {
    margin-top: 1.5rem;
    padding: 1.5rem 1rem;
    text-align: center;
    background: var(--accent-soft);
    border: 4px solid var(--accent);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .win[hidden] {
    display: none;
  }
  .win-mark {
    margin: 0;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--accent);
  }
  .win-word {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .win-text {
    margin: 0;
    font-weight: 600;
  }

  /* ---------------------------------------------------------------------
     PHONES. The whole point of this game is comparing four pictures WHILE
     choosing letters, so pictures + slots + rack have to share one screen.
     The fixed-height parts (text band, slots, rack) are laid out first and
     the picture grid takes whatever height is left — it is `flex: 1` with a
     square aspect-ratio, so it shrinks instead of shoving the rack below the
     fold. Nothing here shrinks a tap target below --tap (64px).
     --------------------------------------------------------------------- */
  @media (max-width: 560px), (max-height: 560px) {
    .play {
      display: flex;
      flex-direction: column;
      /* A HEIGHT, not a min-height: the box has to be able to squeeze the
         pictures, and flex items only shrink when the container is smaller
         than their content. svh, not vh: vh is the viewport at its TALLEST,
         so a vh layout always overflows while the browser bar is showing. */
      height: calc(100svh - var(--chrome) - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    }
    .status,
    .slots,
    .rack {
      flex: none;
    }

    .pics {
      flex: 1 1 auto;
      min-height: 120px;
      gap: 6px;
      margin-bottom: 0.5rem;
    }
    .pics img {
      border-width: 2px;
    }

    /* Long words (5 slots and/or 9 tiles) need two rows of slots and three of
       rack, which squeezes a square 2x2 down to ~57px a picture. A single row
       of four is BOTH shorter and bigger: at 375px each picture is ~80px wide
       against ~57px squeezed, and the block costs 80px of height instead of
       120px. Scanning left-to-right is no worse than a 2x2 for four clues. */
    .crowded .pics {
      flex: 0 0 auto;
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: 1fr;
      aspect-ratio: auto;
      min-height: 0;
      width: 100%;
    }
    .crowded .pics img {
      height: auto;
      aspect-ratio: 1;
    }
    /* Nothing left to give on a 320px screen: claw back the last few pixels
       from the gaps rather than from a tap target. */
    .crowded .pics,
    .crowded .slots {
      margin-bottom: 0.3rem;
    }
    .crowded .status {
      margin-bottom: 0.3rem;
    }

    .status {
      min-height: 1.9em;
      font-size: 0.66em;
      margin-bottom: 0.4rem;
    }
    /* The English gloss is a courtesy for a Gujarati-reading audience; on a
       phone it costs a whole line of the tightest band on the screen. */
    .status .en {
      display: none;
    }

    .slots,
    .rack {
      /* Four cells to a row, never narrower than the 64px tap minimum. */
      --cell: clamp(64px, calc((100% - 3 * var(--cell-gap)) / 4), 84px);
      --cell-gap: 8px;
      gap: var(--cell-gap);
    }
    .slot,
    .tile {
      width: var(--cell);
      /* aspect-ratio, not `height: var(--cell)`: --cell is a % of the row's
         WIDTH, and a percentage height would resolve against the row's
         (auto) height instead and silently collapse to the 64px floor. */
      aspect-ratio: 1;
      height: auto;
      font-size: clamp(1.7rem, 7.5vw, 2.3rem);
    }
    .slots {
      margin-bottom: 0.4rem;
    }
    /* The rack's card frame is pure decoration and costs ~30px of the one
       screen that matters. The tiles already read as buttons. */
    .rack {
      padding: 0;
      border: 0;
      background: none;
    }
    .controls {
      margin-top: 0.75rem;
    }
  }

  /* Landscape on a phone: no vertical room at all, so put the pictures beside
     the letters rather than above them. Rows are placed explicitly so the
     picture block spans the whole playing column. */
  @media (orientation: landscape) and (max-height: 560px) {
    .play {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 1rem;
      align-content: center;
      min-height: calc(100svh - var(--chrome));
    }
    .pics {
      grid-column: 1;
      grid-row: 1 / span 3;
      height: calc(100svh - var(--chrome) - 1rem);
      width: auto;
      max-width: 45vw;
      margin: 0;
      align-self: center;
    }
    .slots {
      grid-column: 2;
      grid-row: 1;
    }
    .status {
      grid-column: 2;
      grid-row: 2;
    }
    .rack {
      grid-column: 2;
      grid-row: 3;
    }
    /* Wide-and-short: fit as many tiles per row as 64px allows rather than the
       portrait four, so the rack is one row instead of two. */
    .slots,
    .rack {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(64px, 1fr));
      justify-items: center;
      gap: 8px;
    }
    .slot,
    .tile {
      width: 100%;
      max-width: 84px;
    }
    .controls {
      margin-top: 0.75rem;
    }
  }

</style>
